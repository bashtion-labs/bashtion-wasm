diff --git a/hw/9pfs/9p-util-stub.c b/hw/9pfs/9p-util-stub.c
new file mode 100644
index 0000000..9ca8f4f
--- /dev/null
+++ b/hw/9pfs/9p-util-stub.c
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * 9p utilities (Emscripten)
+ *
+ * Emscripten's libc ships musl's headers but not its xattr implementation,
+ * and mknodat is unavailable in the browser sandbox. Stub these out: the
+ * 9p "mapped" security models that depend on xattrs are not usable on this
+ * host; security_model=passthrough or none works without them.
+ *
+ * Derived from the equivalent stub in ktock/qemu-wasm (GPL-2.0-or-later).
+ */
+
+#include "qemu/osdep.h"
+#include "9p-util.h"
+
+ssize_t fgetxattr(int fd, const char *name, void *value, size_t size)
+{
+    errno = ENOTSUP;
+    return -1;
+}
+
+ssize_t fgetxattrat_nofollow(int dirfd, const char *path, const char *name,
+                             void *value, size_t size)
+{
+    errno = ENOTSUP;
+    return -1;
+}
+
+int fsetxattrat_nofollow(int dirfd, const char *path, const char *name,
+                         void *value, size_t size, int flags)
+{
+    errno = ENOTSUP;
+    return -1;
+}
+
+ssize_t flistxattrat_nofollow(int dirfd, const char *filename,
+                              char *list, size_t size)
+{
+    errno = ENOTSUP;
+    return -1;
+}
+
+ssize_t fremovexattrat_nofollow(int dirfd, const char *filename,
+                                const char *name)
+{
+    errno = ENOTSUP;
+    return -1;
+}
+
+int qemu_mknodat(int dirfd, const char *filename, mode_t mode, dev_t dev)
+{
+    errno = ENOTSUP;
+    return -1;
+}
